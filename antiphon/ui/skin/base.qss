/* Antiphon base skin. Every color comes from the active theme's :root
   variables; see docs/THEMES.md. Custom-painted widgets (transport buttons,
   sliders, knobs, display, EQ curve) read the same variables directly. */

QWidget {
  color: var(--text);
  font-size: var(--font-size);
}
QMainWindow, QDialog, QMessageBox { background: var(--window); }
QMainWindow::separator { background: var(--border); width: 1px; height: 1px; }

/* --- transport strip ---------------------------------------------------- */
#Transport {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
      stop:0 var(--chrome-top), stop:1 var(--chrome-bottom));
  border-bottom: 1px solid var(--chrome-edge);
}
#Transport QLabel { color: var(--chrome-text); background: transparent; }

/* --- panes -------------------------------------------------------------- */
#NavRail {
  background: var(--panel);
  border: none;
  border-right: 1px solid var(--border);
  padding-top: 6px;
  outline: 0;
}
#NavRail::item {
  padding: 9px 12px;
  border-left: 3px solid transparent;
  color: var(--text-muted);
}
#NavRail::item:hover { background: var(--hover); color: var(--text); }
#NavRail::item:selected {
  background: var(--selection);
  color: var(--selection-text);
  border-left: 3px solid var(--accent);
}
#QueuePane, #BrowseTree { background: var(--panel); }
#PaneTitle {
  color: var(--text-muted);
  font-weight: bold;
  padding: 6px 8px 4px 8px;
}

QSplitter::handle { background: var(--border); }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* --- item views --------------------------------------------------------- */
QTableView, QTreeView, QListView {
  background: var(--surface);
  alternate-background-color: var(--surface-alt);
  border: none;
  selection-background-color: var(--selection);
  selection-color: var(--selection-text);
  gridline-color: var(--border);
  outline: 0;
}
QTableView::item, QTreeView::item, QListView::item { padding: 2px 4px; }
QTableView::item:hover, QTreeView::item:hover, QListView::item:hover {
  background: var(--hover);
}
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
  background: var(--selection);
  color: var(--selection-text);
}
QHeaderView { background: var(--panel); border: none; }
QHeaderView::section {
  background: var(--panel);
  color: var(--text-muted);
  border: none;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 4px 6px;
}
QHeaderView::section:hover { color: var(--text); }
QTableCornerButton::section { background: var(--panel); border: none; }

/* --- inputs ------------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QAbstractSpinBox {
  background: var(--input);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 4px 6px;
  selection-background-color: var(--accent);
  selection-color: var(--accent-text);
}
QLineEdit:focus, QComboBox:focus { border: 1px solid var(--accent); }
QLineEdit:disabled, QComboBox:disabled { color: var(--text-muted); }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
  background: var(--surface);
  border: 1px solid var(--border);
  selection-background-color: var(--selection);
  selection-color: var(--selection-text);
}

QPushButton {
  background: var(--button);
  color: var(--button-text);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 5px 12px;
}
QPushButton:hover { background: var(--button-hover); }
QPushButton:pressed, QPushButton:checked {
  background: var(--accent);
  color: var(--accent-text);
  border-color: var(--accent);
}
QPushButton:disabled { color: var(--text-muted); background: var(--panel); }
QPushButton:default { border: 1px solid var(--accent); }

QCheckBox, QRadioButton { spacing: 6px; }

/* --- menus, tooltips, status -------------------------------------------- */
QMenuBar { background: var(--chrome-top); color: var(--chrome-text); }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: var(--hover); color: var(--text); }
QMenu {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 4px 0;
}
QMenu::item { padding: 5px 22px 5px 22px; }
QMenu::item:selected { background: var(--selection); color: var(--selection-text); }
QMenu::item:disabled { color: var(--text-muted); }
QMenu::separator { height: 1px; background: var(--border); margin: 4px 8px; }
QToolTip {
  background: var(--tooltip);
  color: var(--tooltip-text);
  border: 1px solid var(--border);
  padding: 4px;
}
QStatusBar { background: var(--panel); color: var(--text-muted); border-top: 1px solid var(--border); }
QStatusBar QLabel { color: var(--text-muted); }

/* --- scrollbars --------------------------------------------------------- */
QScrollBar:vertical { background: transparent; width: 11px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 11px; margin: 0; }
QScrollBar::handle {
  background: var(--scrollbar);
  border-radius: 4px;
  min-height: 24px;
  min-width: 24px;
  margin: 2px;
}
QScrollBar::handle:hover { background: var(--scrollbar-hover); }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* --- equalizer ---------------------------------------------------------- */
#EqPeak { color: var(--warning); }
#EqValue { color: var(--text-muted); }
